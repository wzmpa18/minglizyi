    {
      "id": "09-section-25",
      "title": "十八、工具抽屉交流、好友和学习群",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-26",
      "title": "十九、师傅体系与交易：做真实资质，不做伪装市场",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-27",
      "title": "价格、平台费、现有一级/二级/Partner政策从真实SSOT读取，沿用历史合同，不在此指令擅自改比例或强制叠加。支付状态与交付状态分开，退款佣金冲正、幂等、余额和对账实测。",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-28",
      "title": "二十、产品留存与收费建议（先方案，不擅自改价）",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-29",
      "title": "二十一、后台只管理公共服务，不管理用户私人日记",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-30",
      "title": "二十二、技术验收，不只验证页面200",
