    },
    {
      "id": "09-section-31",
      "title": "二十三、必须执行的端到端验收用例",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-32",
      "title": "20 锁屏、后台、断网、正常重启、时区变化、通知拒绝、精确权限拒绝分别实测。",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-33",
      "title": "每项记环境、输入、期望、实际、证据、阻塞和修复提交；重跑后不得通过删断言掩盖失败。",
      "status": "IN_PROGRESS"
