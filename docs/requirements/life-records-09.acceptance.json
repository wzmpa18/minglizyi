    },
    {
      "id": "09-section-4",
      "title": "四、活盘链接与交互式盘面",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-5",
      "title": "五、真实脱敏与接收权限",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-6",
      "title": "六、携盘会话与不同解读者分账",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-7",
      "title": "多盘标签、消息引用、盘内锚点均版本锁定。“指给对方看”由对方主动定位；切盘后旧消息仍关联原盘。",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-8",
      "title": "保留原话、作者当时昵称、来源、时间、原消息ID、盘版本、更正状态。用户修改原话须另存“我的整理”，AI写的是“AI整理”，不冒充医生或老师原话。",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-9",
      "title": "七、人生记录：一个本地库，多分类、多入口",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-10",
      "title": "支持文本、用户选择的图片、PDF以及已支持格式的附件；文件导入通过系统选择器，长文件逐页处理、断点续处理，不静默截掉后半本。任意附件不得执行HTML/SVG脚本、宏或远程嵌入内容。",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-11",
      "title": "八、本地健康档案，帮助就诊沟通而非代替病历",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-12",
      "title": "药名、规格、剂量、频次、途径、起止日期及“必要时服用”分别存储。未确认字段标“未确认”，不自动从模糊原文推断。不能把“每天两次”直接变成自己决定的具体钟点并自动提醒。",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-13",
      "title": "九、图片与手写OCR：能看原图、能纠错、不能瞎认",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-14",
      "title": "十、医嘱与生活提醒：提醒已有安排，不创造医疗决定",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-15",
      "title": "十一、低耗电系统调度，不做假常驻",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-16",
      "title": "用户数量多、日程多时使用系统容量允许的滚动队列；重复事件能用系统重复则用，明确当前已安排到哪天、后续补排条件。不得声称预登记了无限数量提醒；不把旧iOS API数字硬套现行所有设备。",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-17",
      "title": "十二、本地搜索：先文字索引，再可选语义整理",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-18",
      "title": "十三、AI的数据路径与成本：严格按用户选择",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-19",
      "title": "十四、本机安全与长久保存",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-20",
      "title": "附件、缩略图、OCR索引、导出暂存、通知、崩溃日志都要同等保护。默认不把医疗图片放公共相册；自动备份/系统迁移的实际范围要核验并告知，不笼统声称“本地就不会出设备”。",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-21",
      "title": "十五、用户自己的云与导出：先做可恢复，不是假上传成功",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-22",
      "title": "十六、Web版的能力边界不能藏起来",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-23",
      "title": "十七、同辰、同校与同机构好奇心匹配",
      "status": "IN_PROGRESS"
    },
    {
      "id": "09-section-24",
      "title": "搜索限频、禁止精确条件批量枚举/下载、隐藏稀有群组人数、分页控制、请求双方确认。只显示双方允许的共同标签，不返回出生原始库；不造“天生合适/最佳伴侣/命定缘分”评分。",
      "status": "IN_PROGRESS"
