    "Only a private summary, never names or birthdays": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a private summary, never names or birthdays"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示隐私摘要，不显示姓名和生日"
