    "Calendar data follows the observation zone selected in the app. Private event details stay hidden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar data follows the observation zone selected in the app. Private event details stay hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历法采用应用内选定的观察时区。私人事项详情保持隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曆法採用應用程式所選觀察時區。私人事項詳情保持隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暦はアプリで選択した観測時区を使用します。予定の詳細は非表示です。"
          }
        }
      }
    }
  },
  "version": "1.0"
