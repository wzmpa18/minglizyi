# ============================================================================
# 言道国学后端环境变量配置 - v20.4
# 复制此文件为 .env 并填写真实值
# 部署目录：/root/backend-auth/
# ============================================================================

# ----------------------------------------------------------------------------
# 腾讯云SMS（短信验证码）
# 密钥从环境变量读取，业务参数已硬编码在 smsService.js 中：
#   SdkAppId  = 1401146274
#   模板ID    = 186686
#   签名      = 东莞言道科技有限公司
#   地区      = ap-guangzhou
#   模板参数   {1}=验证码  {2}=有效时间(5分钟)
# ----------------------------------------------------------------------------
TENCENT_SMS_SECRET_ID=your_sms_secret_id
TENCENT_SMS_SECRET_KEY=your_sms_secret_key

# ----------------------------------------------------------------------------
# 腾讯云SES（邮件推送验证码）
# 密钥从环境变量读取，业务参数已硬编码在 emailService.js 中：
#   发件地址  = noreply@yandao.vip
#   模板ID    = 186641
#   发件人名称 = 言道国学
#   地区      = ap-guangzhou
#   模板变量   {{.code}}=验证码  {{.expire}}=有效时间(5分钟)
# ----------------------------------------------------------------------------
TENCENT_SES_SECRET_ID=your_ses_secret_id
TENCENT_SES_SECRET_KEY=your_ses_secret_key
TENCENT_SES_FROM_EMAIL=noreply@yandao.vip
TENCENT_SES_TEMPLATE_ID=186641

# ----------------------------------------------------------------------------
# JWT 认证
# access token 有效期 7 天，refresh token 有效期 30 天
# ----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_change_this_to_random_string
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# ----------------------------------------------------------------------------
# 数据库（SQLite）
# 部署到 /root/backend-auth/ 时使用以下路径
# ----------------------------------------------------------------------------
DB_PATH=/root/backend-auth/data/yandao_users.db

# ----------------------------------------------------------------------------
# 微信支付（API v3）
# 参数到位后填入即可启用微信支付通道
# 文档：https://pay.weixin.qq.com/docs/merchant/products/native-payment/introduction.html
#   WECHAT_MCH_ID       商户号
#   WECHAT_APPID        应用ID（公众号/小程序/APP）
#   WECHAT_API_V3_KEY   APIv3密钥（32位）
#   WECHAT_API_CERT_PATH 商户API私钥证书路径（apiclient_key.pem）
#   WECHAT_SERIAL_NO    商户证书序列号（可选，预留）
#   WECHAT_NOTIFY_URL   支付回调地址（可选，代码内可硬编码）
# ----------------------------------------------------------------------------
WECHAT_MCH_ID=
WECHAT_APPID=
WECHAT_API_V3_KEY=
WECHAT_API_CERT_PATH=

# ----------------------------------------------------------------------------
# 支付宝
# 参数到位后填入即可启用支付宝支付通道
# 文档：https://opendocs.alipay.com/open/270/105898
#   ALIPAY_APP_ID          应用APPID
#   ALIPAY_APP_PRIVATE_KEY 应用私钥（RSA2，Base64编码）
#   ALIPAY_PUBLIC_KEY      支付宝公钥（用于回调验签）
#   ALIPAY_GATEWAY         网关地址（可选，默认 https://openapi.alipay.com/gateway.do）
# ----------------------------------------------------------------------------
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ----------------------------------------------------------------------------
# 混元AI（内容自动生成导入）
# 用于自动生成中医典籍、易学题库、中医题库等内容
# 接口地址：https://tokenhub.tencentmaas.com/v1/chat/completions
# 模型：hy3
# ----------------------------------------------------------------------------
HUNYUAN_API_KEY=sk-your-hunyuan-api-key-here
HUNYUAN_API_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
HUNYUAN_MODEL=hy3

# ----------------------------------------------------------------------------
# 管理员API密钥（内容导入接口鉴权）
# ----------------------------------------------------------------------------
ADMIN_API_KEY=your-admin-api-key-here
